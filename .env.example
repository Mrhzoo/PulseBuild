# PulseBuild local / staging. Never commit real secrets.

APP_ENV=development
APP_SECRET_KEY=change-me
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://pulsebuild:pulsebuild@localhost:5432/pulsebuild
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_BUCKET=pulsebuild-docs
S3_REGION=eu-central-1

# Launch region: single default. Move only if a paying customer requires UAE residency.
DATA_REGION=eu-central-1
DEFAULT_COUNTRY=UAE
DEFAULT_CURRENCY=AED

LLM_CLASSIFY_MODEL=gpt-4.1-mini
LLM_REASONING_MODEL=gpt-4.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Per-tenant daily token cap (cost control)
TENANT_DAILY_TOKEN_CAP=250000

# Email (SLA channel)
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_SECRET=
MAIL_FROM=briefing@pulsebuild.local

# Optional later
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
